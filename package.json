{
  "name": "vangard-studio",
  "version": "1.1.1",
  "author": {
    "name": "Blue Moon Foundry Software",
    "email": "support@bluemoonfoundry.com"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode development",
    "capture-screenshots": "node docs/capture_screenshots.js",
    "capture-broll": "node docs/capture_broll.js",
    "generate-vo": "node docs/marketing/generate_vo.js",
    "assemble-reel": "node docs/marketing/assemble_reel.js",
    "build-reel": "node docs/marketing/build_reel.js",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "preview": "vite preview",
    "electron:start": "npm run build && electron .",
    "predist": "node -e \"const fs=require('fs');try{fs.rmSync('release',{recursive:true,force:true})}catch(e){}\"",
    "dist": "npm run build && electron-builder",
    "version:patch": "node version.js patch",
    "version:minor": "node version.js minor",
    "version:major": "node version.js major",
    "version:set": "node version.js set",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release:patch": "npm run version:patch && npm run build",
    "release:minor": "npm run version:minor && npm run build",
    "release:major": "npm run version:major && npm run build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "dompurify": "^3.4.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-dag": "^0.4.1",
    "graphology-types": "^0.24.8",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "marked": "^17.0.5",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.3.1",
    "recharts": "^3.7.0",
    "sharp": "^0.33.5",
    "use-immer": "^0.10.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.19",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.0.0",
    "playwright": "^1.49.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.0.8",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.bluemoonfoundry.vangard",
    "productName": "Vangard Studio",
    "executableName": "vangard-studio",
    "publish": {
      "provider": "github",
      "owner": "bluemoonfoundry",
      "repo": "bmf-vangard-renpy-ide"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "vangard.png",
      "src/lib/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "vangard.png",
      "artifactName": "Vangard_Studio_Windows_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vangard Studio"
    },
    "mac": {
      "target": "dmg",
      "icon": "vangard.png",
      "artifactName": "Vangard_Studio_macOS_${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "vangard.png",
      "artifactName": "Vangard_Studio_Linux_${version}.${ext}",
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "resources/renpy-template",
        "to": "renpy-template",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
